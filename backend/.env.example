# 数据库
DATABASE_URL=postgresql://docformat_user:docformat_pass@localhost:5432/docformat
DATABASE_URL_TEST=postgresql://docformat_user:docformat_pass@localhost:5432/docformat_test

# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# AI 服务（当前激活：qwen 或 openai）
AI_PROVIDER=qwen
QWEN_API_KEY=your-qwen-key
OPENAI_API_KEY=your-openai-key

# 文件存储
UPLOAD_DIR=./storage/uploads
OUTPUT_DIR=./storage/outputs
MAX_FILE_SIZE_MB=20

# 应用
DEFAULT_COMPANY_NAME=北京昱华源码科技有限公司
APP_ENV=development
